# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_* values are sent to the browser; everything else is server-only.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# Local: run `npm run db:start`, then copy the API URL, publishable key and secret key it prints
# (the URL is http://127.0.0.1:54321). Hosted: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Bypasses RLS. Server-only: jobs, webhooks, Pub/Sub handlers. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Sign in with Google (Supabase Auth provider; the secret is read by the Supabase CLI/dashboard, not the app) ---
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Google OAuth for Business Profile (separate from Supabase "Sign in with Google") ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback
# 32-byte key (base64) for encrypting stored refresh tokens.
TOKEN_ENCRYPTION_KEY=

# --- Google Cloud Pub/Sub (review notifications, Phase 2) ---
GOOGLE_CLOUD_PROJECT_ID=
GBP_PUBSUB_TOPIC=
# Expected audience / service account for verifying push-subscription OIDC tokens.
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNT=

# --- Scheduled jobs (Vercel Cron) ---
CRON_SECRET=

# --- Rate limiting / monitoring (provider TBD) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# SENTRY_DSN=
